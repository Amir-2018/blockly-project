<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('head', { title: 'Éditeur Python — Amir Academy' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body class="editor-page">
    <header class="app-header">
        <div class="header-inner">
            <div class="editor-brand">
                <span class="editor-brand-badge"><img src="/images/Gemini_Generated_Image_81m0sb81m0sb81m0.jpeg" alt="Logo Amir Academy" /></span>
                <div>
                    <h3 class="animated-title" id="title" aria-label="Amir Academy" ></h1>
                    <p class="subtitle">Élève : <%= student.prenom %> <%= student.nom %> — <%= student.classe %></p>
                </div>
            </div>
        </div>
        <nav class="top-nav">
          
            <button class="nav-btn" id="runBtn" title="Run the generated Python">
                <span class="play-icon">&#9654;</span> Run
            </button>
            <button class="nav-btn ghost" id="genBtn" title="Refresh generated code">Generate</button>
            <button class="nav-btn ghost" id="clearBtn" title="Clear the workspace">Clear</button>
            <button class="nav-btn ghost" id="sampleBtn" title="Load a sample program">Sample</button>
          <div class="account-menu">
                <button class="nav-btn ghost account-menu-btn" id="accountMenuBtn" type="button" title="Menu du compte" aria-label="Menu du compte" aria-expanded="false" aria-controls="accountMenu">
                    <i class="fa-solid fa-bars" aria-hidden="true"></i>
                </button>
                <div class="account-menu-list" id="accountMenu" hidden>
                    <a href="/logout"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Déconnexion</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="workspace-area">
        <section class="blockly-pane" id="blocklyPane">
            <div id="blocklyDiv"></div>
        </section>

        <div class="resizer" id="resizer" title="Drag to resize"></div>

        <aside class="code-pane">
            <div class="code-tabs">
                <button class="tab active" data-tab="python">Python</button>
                <button class="tab" data-tab="console">Console</button>
                <button class="tab" data-tab="robot">Robot</button>
                <span class="tab-status" id="statusDot"></span>
                <div class="menu-wrap">
                    <button class="menu-btn" id="menuBtn" title="Menu" aria-haspopup="true" aria-expanded="false">&#8942;</button>
                    <div class="menu-list" id="menuList" hidden>
                        <button id="dlPdf"><span class="mi">&#128196;</span> Télécharger en PDF</button>
                        <button id="dlPy"><span class="mi">&#128190;</span> Télécharger .py</button>
                    </div>
                </div>
            </div>
            <pre class="code-output" id="pythonCode"><code># Your Python code will appear here...</code></pre>
            <pre class="console-output" id="consoleOut" hidden>&gt; Ready. Press Run to execute your code.</pre>
            <div class="robot-pane" id="robotPane" hidden>
                <div class="robot-bar">
                    <button class="nav-btn" id="robotRun"><span class="play-icon">&#9654;</span> Exécuter le robot</button>
                    <button class="nav-btn ghost" id="robotReset">&#8635; Réinitialiser</button>
                    <span class="robot-hint">Empile des blocs « Robot » puis exécute</span>
                </div>
                <canvas id="robotCanvas"></canvas>
            </div>
        </aside>
    </main>

    <!-- Blockly core + default blocks + Python generator + messages -->
    <script src="https://unpkg.com/blockly@9.2.0/blockly_compressed.js"></script>
    <script src="https://unpkg.com/blockly@9.2.0/blocks_compressed.js"></script>
    <script src="https://unpkg.com/blockly@9.2.0/python_compressed.js"></script>
    <script src="https://unpkg.com/blockly@9.2.0/msg/en.js"></script>
    <!-- Skulpt to actually run the generated Python in the browser -->
    <script src="https://cdn.jsdelivr.net/npm/skulpt@1.2.0/dist/skulpt.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/skulpt@1.2.0/dist/skulpt-stdlib.js"></script>
    <!-- jsPDF to export the generated code as a PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>window.allowedBlockTypes = <%- JSON.stringify(typeof allowedBlockTypes !== 'undefined' ? allowedBlockTypes : null) %>;</script>

    <script src="/app.js"></script>
</body>
</html>
