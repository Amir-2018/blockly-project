<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('head', { title: 'Espace élève — Amir Academy' }) %>
</head>
<body class="landing auth-page">
    <%- include('navbar', { showTeacher: true, showLogin: false }) %>

    <div class="landing-bg" aria-hidden="true">
        <span class="blob blob-blue"></span>
        <span class="blob blob-yellow"></span>
        <span class="blob blob-blue2"></span>
    </div>

    <div class="landing-split">
        <div class="landing-card landing-left auth-card">
            <div class="py-badge">
                <img src="/images/Gemini_Generated_Image_81m0sb81m0sb81m0.jpeg" alt="Amir Academy logo" />
            </div>
            <h1 class="landing-title">Espace <span class="accent">élève</span></h1>
            <p class="auth-sub">Entre ton nom d'utilisateur et ton pass key pour accéder à l'éditeur.</p>

            <form class="auth-form" method="post" action="/eleve" autocomplete="off">
                <label>Nom d'utilisateur
                    <input type="text" name="username" placeholder="Ton nom d'utilisateur" required />
                </label>
                <label>Pass key
                    <input type="Password" name="key" placeholder="KEY-XXXX-..." required />
                </label>
                <button type="submit" class="cta cta-block">Accéder à l'éditeur</button>
                <% if (error) { %><p class="auth-error">Nom d'utilisateur ou pass key invalide. Vérifie et réessaie.</p><% } %>
            </form>

            <a class="auth-back" href="/">&#8592; Retour à l'accueil</a>
        </div>

        <div>
            <img src="/images/images.png" alt="Illustration Amir Academy" />
        </div>
    </div>
</body>
</html>
