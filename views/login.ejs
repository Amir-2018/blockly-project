<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('head', { title: 'Connexion — Amir Academy' }) %>
</head>
<body class="landing auth-page">
    <%- include('navbar', { showEleve: true, showLogin: false }) %>

    <div class="landing-bg" aria-hidden="true">
        <span class="blob blob-blue"></span>
        <span class="blob blob-yellow"></span>
        <span class="blob blob-blue2"></span>
    </div>

    <div class="landing-split">
        <div class="landing-card landing-left auth-card">
            <div class="py-badge">
                <img src="/images/Gemini_Generated_Image_81m0sb81m0sb81m0.jpeg" alt="Amir Academy logo" />
            </div>
            <h1 class="landing-title">Connexion <span class="accent">admin</span></h1>
            <p class="auth-sub">Accès réservé à l’administrateur.</p>

            <form class="auth-form" method="post" action="/login" autocomplete="off">
                <label>Nom d'utilisateur
                    <input type="text" name="user" placeholder="admin" required />
                </label>
                <label>Mot de passe
                    <input type="password" name="pass" placeholder="••••••" required />
                </label>
                <button type="submit" class="cta cta-block">Se connecter</button>
                <% if (error) { %><p class="auth-error">Identifiants incorrects.</p><% } %>
            </form>

            <a class="auth-back" href="/">&#8592; Retour à l'accueil</a>
        </div>

        <div class="landing-right">
            <img src="/images/images.png" alt="Illustration Amir Academy" />
        </div>
    </div>
</body>
</html>
